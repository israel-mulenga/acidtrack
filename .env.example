# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Notifications push — clé publique VAPID (voir README, section
# « Notifications push »). Générée par `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=votre_cle_publique_vapid

# Développement uniquement : affiche un sélecteur de compte démo dans
# l'en-tête (connexion réelle avec les comptes de supabase/05_seed_auth.sql).
# Ne jamais activer en production.
VITE_DEV_PROFILE_SWITCH=true
